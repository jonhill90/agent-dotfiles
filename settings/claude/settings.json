{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "hooks/tmux-destructive-verb-guard.sh" },
          { "type": "command", "command": "hooks/tmux-protected-target-guard.sh" },
          { "type": "command", "command": "hooks/main-branch-guard.sh" },
          { "type": "command", "command": "hooks/gh-body-guard.sh" },
          { "type": "command", "command": "hooks/lane-self-close-guard.sh" },
          { "type": "command", "command": "hooks/ledger-write-guard.sh" }
        ]
      }
    ]
  }
}
