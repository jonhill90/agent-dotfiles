#!/bin/bash
# Stub tmux for lanes.sh tests. LANES_FIXTURE holds one line per window:
#   <index>|<name>|<command>|<first-capture>|<second-capture>
# Two capture columns let a test express "looks busy and never advances"
# (hung) versus "looks busy and advances" (busy) deterministically, which is
# the distinction the real detector exists to make.
F="${LANES_FIXTURE:?}"
sub="$1"; shift
target=""; fmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target="$2"; shift 2 ;;
    -p|-S) shift ;;
    -*) shift ;;
    *) fmt="$1"; shift ;;
  esac
done
win="${target##*:}"; win="${win%%.*}"
line=$(awk -F'|' -v w="$win" '$1==w' "$F")
case "$sub" in
  has-session) exit 0 ;;
  list-windows) cut -d'|' -f1 "$F" ;;
  display-message)
    case "$fmt" in
      '#{window_name}') cut -d'|' -f2 <<<"$line" ;;
      '#{pane_current_command}') cut -d'|' -f3 <<<"$line" ;;
    esac ;;
  capture-pane)
    marker="${LANES_CALLS:-/tmp/lanes-calls}.$win"
    seen=$(cat "$marker" 2>/dev/null || echo 0)
    echo $((seen+1)) > "$marker"
    if [ "$seen" -eq 0 ]; then cut -d'|' -f4 <<<"$line"; else cut -d'|' -f5 <<<"$line"; fi ;;
esac
exit 0
